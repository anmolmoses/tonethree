{
  "manifest_version": 3,
  "name": "ToneThree for Codex",
  "description": "Turn any rough thought into Natural, Personal, and Viral Twitter/X posts without losing your voice.",
  "version": "1.1.0",
  "key": "MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBALvLkqPqzT8sJvJmQ6Cwq9Gd7eW4xWfJXqY7sD4m9d2Yv0Hk8jU2vT9dZxqR3iYpL6NwF1bK5cE7aP0uQ9xRkUsCAwEAAQ==",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rewrite with ToneThree",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
